               }
               .navigationTitle("Pro Features")
               .navigationBarTitleDisplayMode(.inline)
           }
       }
   }
   
   
   // MARK: - Multi Page Drawing View
   
struct MultiPageDrawingView: View {
    @ObservedObject var store: ColoringPagesStore
    let groupIndices: [Int]          // indices into store.pages
    @State private var selectedIndexInGroup: Int
    let title: String                // base book/pdf name
    
    // 🔹 NEW: rename UI state
       @State private var showingRenameSheet: Bool = false
       @State private var renameText: String = ""
    
    @State private var isPageStripVisible: Bool
    
    init(store: ColoringPagesStore,
         groupIndices: [Int],
         initialGroupIndex: Int,
         title: String) {
        self.store = store
        self.groupIndices = groupIndices
        _selectedIndexInGroup = State(initialValue: initialGroupIndex)
        _isPageStripVisible = State(initialValue: groupIndices.count > 1)
        self.title = title
    }
    
    private var hasMultiplePages: Bool {
        groupIndices.count > 1
    }
    
    // Current absolute index in store.pages
    private var currentStoreIndex: Int {
        groupIndices[selectedIndexInGroup]
    }
    
    private var currentLinesBinding: Binding<[Line]> {
        Binding(
            get: { store.pages[currentStoreIndex].lines },
            set: { newLines in
                var page = store.pages[currentStoreIndex]
                page.lines = newLines
                store.pages[currentStoreIndex] = page   // re-assigns element to trigger @Published
            }
        )
    }
    
    
    // 🔹 NEW: instead of a Binding<Data?>, just load the background image on demand
    private var currentBackgroundImage: UIImage? {
        store.loadBackgroundImage(for: store.pages[currentStoreIndex])
    }
    
    
    private var currentTitle: String {
        if groupIndices.count > 1 {
            return "\(title) (\(selectedIndexInGroup + 1)/\(groupIndices.count))"
        } else {
            return title
        }
    }
    
    private let pageStripReservedHeight: CGFloat = 84

    var body: some View {
        ZStack(alignment: .bottom) {
            DrawingView(
                title: currentTitle,
                lines: currentLinesBinding,
                backgroundImage: currentBackgroundImage,
                isPageStripVisible: $isPageStripVisible,
                canShowPagesButton: hasMultiplePages,
                onRenameRequested: {
                    let page = store.pages[currentStoreIndex]
                    renameText = baseNameForPage(page)
                    showingRenameSheet = true
                }
            )
            .frame(maxWidth: .infinity, maxHeight: .infinity)

            if hasMultiplePages && isPageStripVisible {
                pageStripOverlay
                    .transition(.move(edge: .bottom).combined(with: .opacity))
                    .zIndex(10)
            }
        }
        .animation(.easeInOut(duration: 0.2), value: isPageStripVisible)
        .onDisappear {
            store.forceSave()
        }
        .sheet(isPresented: $showingRenameSheet) {
            NavigationStack {
                VStack(alignment: .leading, spacing: 16) {
                    Text("Rename Colouring Page")
                        .font(.title2.bold())

                    Text("This will rename this colouring page. For multi-page PDFs, all pages in this book will use the new name.")
                        .font(.subheadline)
                        .foregroundColor(.secondary)

                    TextField("New name", text: $renameText)
                        .textFieldStyle(.roundedBorder)
                        .padding(.top, 4)

                    Spacer()

                    HStack {
                        Button("Cancel") {
                            showingRenameSheet = false
                        }

                        Spacer()

                        Button("Save") {
                            renameCurrentGroup(to: renameText)
                            showingRenameSheet = false
                        }
                        .disabled(renameText.trimmingCharacters(in: .whitespacesAndNewlines).isEmpty)
                        .buttonStyle(.borderedProminent)
                    }
                }
                .padding()
            }
        }
    }
    
    private var pageStripOverlay: some View {
        VStack(spacing: 0) {
            pageStrip
                .padding(.top, 8)
                .padding(.bottom, 10)
                .background(Color(UIColor.systemGroupedBackground))
                .clipShape(
                    RoundedRectangle(cornerRadius: 16, style: .continuous)
                )
                .shadow(color: .black.opacity(0.12), radius: 8, y: 2)
                .padding(.horizontal, 10)
                .padding(.bottom, 8)
        }
    }
    
    private func pageStripThumbnail(for page: ColoringPage) -> some View {
        Canvas { context, size in
            var ctx = context

            let rect = CGRect(origin: .zero, size: size)
            ctx.fill(Path(rect), with: .color(.white))

            // Track scale + draw rect for the background image
            var imageDrawRect = rect
            var drawScale: CGFloat = 1.0

            if let uiImage = store.loadBackgroundImage(for: page) {
                let image = Image(uiImage: uiImage)
                let resolved = ctx.resolve(image)
                let imgSize = resolved.size

                let scale = min(size.width / imgSize.width,
                                size.height / imgSize.height)
                drawScale = scale

                let drawSize = CGSize(
                    width: imgSize.width * scale,
                    height: imgSize.height * scale
                )
                let x = (size.width - drawSize.width) / 2
                let y = (size.height - drawSize.height) / 2

                imageDrawRect = CGRect(origin: CGPoint(x: x, y: y), size: drawSize)
                ctx.draw(resolved, in: imageDrawRect)
            }

            // Map stored points -> actual thumbnail coordinates
            func viewPoints(for line: Line) -> [CGPoint] {
                line.points.map { p in
                    switch line.pointSpace {
                    case .imageNormalized, .legacyViewNormalized:
                        return CGPoint(
                            x: imageDrawRect.minX + p.x * imageDrawRect.width,
                            y: imageDrawRect.minY + p.y * imageDrawRect.height
                        )
                    case .viewPoints:
                        return p
                    }
                }
            }

            // Keep strokes thin but visible in the strip
            func stripLineWidth(for line: Line) -> CGFloat {
                let base = (line.lineWidth ?? 7)
                let raw = base * pow(drawScale, 0.65) * 0.9
                return min(max(raw, 0.7), 4.0)
            }

            func strokeLine(_ line: Line, in g: inout GraphicsContext) {
                let pts = viewPoints(for: line)
                guard pts.count >= 2 else { return }

                var path = Path()
                path.move(to: pts[0])
                for p in pts.dropFirst() { path.addLine(to: p) }

                g.stroke(
                    path,
                    with: .color(line.color),
                    style: StrokeStyle(
                        lineWidth: stripLineWidth(for: line),
                        lineCap: .round,
                        lineJoin: .round
                    )
                )
            }

            // --- Multiply strokes (under the line art) ---
            ctx.blendMode = .multiply
            ctx.drawLayer { layer in
                layer.blendMode = .normal
                for line in page.lines where line.isMultiply {
                    strokeLine(line, in: &layer)
                }
            }

            // --- Normal strokes on top ---
            ctx.blendMode = .normal
            for line in page.lines where !line.isMultiply {
                strokeLine(line, in: &ctx)
            }
        }
    }
    
    // Bottom grid/strip of pages
    private var pageStrip: some View {
        ScrollView(.horizontal, showsIndicators: false) {
            HStack(spacing: 8) {
                ForEach(Array(groupIndices.enumerated()), id: \.1) { (localIndex, storeIndex) in
                    let page = store.pages[storeIndex]

                    VStack(spacing: 4) {
                        pageStripThumbnail(for: page)
                            .frame(width: 80, height: 60)
                            .background(Color.white)
                            .cornerRadius(8)
                            .overlay(
                                RoundedRectangle(cornerRadius: 8)
                                    .stroke(
                                        localIndex == selectedIndexInGroup
                                        ? Color.blue
                                        : Color.clear,
                                        lineWidth: 2
                                    )
                            )

                        Text("\(localIndex + 1)")
                            .font(.caption2)
                            .foregroundColor(.secondary)
                    }
                    .onTapGesture {
                        selectedIndexInGroup = localIndex
                    }
                }
            }
            .padding(.horizontal, 8)
        }
        .frame(height: 86)
    }
    
    // Strip " - Page N" off the name to get the base book name
    private func baseNameForPage(_ page: ColoringPage) -> String {
        if let range = page.name.range(of: " - Page ") {
            return String(page.name[..<range.lowerBound])
        } else {
            return page.name
        }
    }
    
    // Actually rename the current book / page group
    private func renameCurrentGroup(to newBaseName: String) {
        let trimmed = newBaseName.trimmingCharacters(in: .whitespacesAndNewlines)
        guard !trimmed.isEmpty else { return }
        
        if groupIndices.count == 1 {
            // Single-page book: just rename that page
            let idx = currentStoreIndex
            var page = store.pages[idx]
            page.name = trimmed
            store.pages[idx] = page
        } else {
            // Multi-page book: rename all pages, preserving " - Page N"
            for (position, idx) in groupIndices.enumerated() {
                var page = store.pages[idx]
                page.name = "\(trimmed) - Page \(position + 1)"
                store.pages[idx] = page
            }
        }
    }
    
    // MARK: - Drawing Screen
    
    struct DrawingView: View {
        
        let title: String
        @Binding var lines: [Line]
        let backgroundImage: UIImage?
        
        @Binding var isPageStripVisible: Bool
        
        let canShowPagesButton: Bool
        
        // 🔹 NEW: callback to trigger rename UI in the parent
               let onRenameRequested: () -> Void
        
        @Environment(\.dismiss) private var dismiss
        
        
        // Dark UI:
        @AppStorage("isDarkUI") private var isDarkUI: Bool = false
        
        // Persisted last-used color
        @AppStorage("lastColor_r") private var lastColorR: Double = 1.0
        @AppStorage("lastColor_g") private var lastColorG: Double = 0.5
        @AppStorage("lastColor_b") private var lastColorB: Double = 0.0
        @AppStorage("lastColor_a") private var lastColorA: Double = 1.0
        
        @State private var selectedColor: Color = .orange
        
        @State private var isErasing = false
        @State private var useMultiplyPen = true
        
        // Portrait support for Iphone
        @Environment(\.horizontalSizeClass) private var hSizeClass
        
        // Export state
        @State private var exportTrigger: Int = 0
        @State private var exportedImage: UIImage? = nil
        @State private var isShowingShareSheet: Bool = false
        
        // One-time info before showing the share sheet (which can save to Photos)
        @AppStorage("hasSeenPhotoSaveInfo") private var hasSeenPhotoSaveInfo: Bool = false
        @State private var showPhotoSaveInfo = false
        
        
        @State private var canvasRotationSteps: Int = 0   // 0, 1, 2, 3  => 0°, 90°, 180°, 270°
        private var canvasRotationAngle: Angle {
            Angle(degrees: Double(canvasRotationSteps * 90))
        }
        
        // Brush size (slider)
        @State private var brushSize: Double = 7
        
        // Undo / redo (stroke-level)
        @State private var redoStack: [Line] = []
        @State private var lastLinesCount: Int = 0
        @State private var isPerformingUndoRedo = false
        
        // Confirm clear pop up
        @State private var showClearAlert = false
        
        
        private var toolbarIconColor: Color {
            isDarkUI ? .white : .primary
        }
        
        private var toolbarTextColor: Color {
            isDarkUI ? .white : .primary
        }
        
        // MARK: - Size class helper
        private var isCompact: Bool {
            hSizeClass == .compact
        }
        
        var body: some View {
            ZStack {
                // Light grey background behind everything
                Color(UIColor.systemGray5)
                    .ignoresSafeArea()
                
                VStack(spacing: 0) {
                    
                    // MARK: - Toolbar
                    
                    
                    if hSizeClass == .compact {
                        // 📱 iPhone: hamburger menu on the LEFT, tools on the RIGHT
                        HStack(spacing: 12) {
                            
                            // 🍔 LEFT: Hamburger menu (Home + Export + Clear)
                            Menu {
                                // Home
                                Button {
                                    dismiss()
                                } label: {
                                    Label("Home", systemImage: "house.fill")
                                }
                                
                                if canShowPagesButton {
                                    Button {
                                        withAnimation(.easeInOut(duration: 0.2)) {
                                            isPageStripVisible.toggle()
                                        }
                                    } label: {
                                        Text("Pages")
                                            .font(.headline)
                                            .foregroundColor(toolbarTextColor)
                                            .padding(.horizontal, 10)
                                            .padding(.vertical, 6)
                                            .background(
                                                isPageStripVisible
                                                ? Color.blue.opacity(isDarkUI ? 0.35 : 0.18)
                                                : Color.gray.opacity(isDarkUI ? 0.35 : 0.18)
                                            )
                                            .clipShape(Capsule())
                                    }
                                }
                                
                                // Export Page (keep one-time info flow)
                                Button {
                                    if !hasSeenPhotoSaveInfo {
                                        showPhotoSaveInfo = true
                                    } else {
                                        exportTrigger += 1
                                    }
                                } label: {
                                    Label("Export Page", systemImage: "square.and.arrow.up")
                                }
                                // 🔹 NEW: Rename Page
                                            Button {
                                                onRenameRequested()
                                            } label: {
                                                Label("Rename Page", systemImage: "pencil.and.outline")
                                            }
                                
                                // Clear Page
                                Button(role: .destructive) {
                                    showClearAlert = true
                                } label: {
                                    Label("Clear Page", systemImage: "trash")
                                }
                            } label: {
                                Image(systemName: "line.3.horizontal")
                                    .font(.title2)
                                    .foregroundColor(toolbarIconColor)
                                    .padding(8)
                                    .background(
                                        Color.gray.opacity(isDarkUI ? 0.35 : 0.18)
                                    )
                                    .clipShape(Circle())
                            }
                            
                            // 🔹 This Spacer pushes the tool strip all the way to the right
                            Spacer()
                            
                            // 🎨 RIGHT: scrollable tools row
                            ScrollView(.horizontal, showsIndicators: false) {
                                HStack(spacing: 12) {
                                    // Multiply pen
                                    Button {
                                        isErasing = false
                                        useMultiplyPen = true
                                    } label: {
                                        Image(systemName: "pencil.tip")
                                            .font(.title2)
                                            .foregroundColor(toolbarIconColor)
                                            .padding(6)
                                            .background(
                                                (!isErasing && useMultiplyPen)
                                                ? Color.gray.opacity(0.2)
                                                : Color.clear
                                            )
                                            .clipShape(Circle())
                                    }
                                    // (Normal pen still commented out if you don’t want it)
                                    Button {
                                        isErasing = false
                                        useMultiplyPen = false
                                    } label: {
                                        Image(systemName: "highlighter")
                                            .font(.title2)
                                            .foregroundColor(toolbarIconColor)
                                            .padding(6)
                                            .background(
                                                (!isErasing && !useMultiplyPen)
                                                ? Color.gray.opacity(0.2)
                                                : Color.clear
                                            )
                                            .clipShape(Circle())
                                    }
                                    
                                    // Eraser
                                    Button {
                                        isErasing = true
                                    } label: {
                                        Image(systemName: "eraser")
                                            .font(.title2)
                                            .foregroundColor(toolbarIconColor)
                                            .padding(6)
                                            .background(
                                                isErasing
                                                ? Color.gray.opacity(0.2)
                                                : Color.clear
                                            )
                                            .clipShape(Circle())
                                    }
                                    
                                    // Undo
                                    Button {
                                        performUndo()
                                    } label: {
                                        Image(systemName: "arrow.uturn.backward")
                                            .font(.title2)
                                        //.foregroundColor(toolbarIconColor)
                                            .padding(6)
                                    }
                                    .disabled(lines.isEmpty)
                                    
                                    
                                    // Redo
                                    Button {
                                        performRedo()
                                    } label: {
                                        Image(systemName: "arrow.uturn.forward")
                                            .font(.title2)
                                            .foregroundColor(toolbarIconColor)
                                            .padding(6)
                                    }
                                    .disabled(redoStack.isEmpty)
                                    
                                    Button {
                                        canvasRotationSteps = (canvasRotationSteps + 1) % 4
                                    } label: {
                                        Image(systemName: "rotate.right")
                                            .font(.title2)
                                            .foregroundColor(toolbarIconColor)
                                            .padding(6)
                                            .background(Color.gray.opacity(0.2))
                                            .clipShape(Circle())
                                    }
                                    
                                    
                                    // Color picker
                                    ColorPicker(selection: $selectedColor, supportsOpacity: true) {
                                        Image(systemName: "eyedropper.halffull")
                                            .font(.title2)
                                            .foregroundColor(toolbarIconColor)
                                            .padding(6)
                                            .background(Color.gray.opacity(0.2))
                                            .clipShape(RoundedRectangle(cornerRadius: 8))
                                    }
                                    .labelsHidden()
                                }
                                // make the tools hug the right inside the scroll area
                                .frame(maxWidth: .infinity, alignment: .trailing)
                            }
                            // and make the whole scroll view act like a right-aligned cluster
                            .frame(maxWidth: .infinity, alignment: .trailing)
                        }
                        .padding(.horizontal)
                        .padding(.vertical, 8)
                        .frame(maxWidth: .infinity)
                        .background(
                            (isDarkUI
                             ? Color.cosyDarkBackground.opacity(0.95)
                             : Color(UIColor.systemBackground).opacity(0.95)
                            )
                            .ignoresSafeArea(edges: .top)
                        )
                        .zIndex(1)
                        
                    } else {
                        // 💻 iPad / regular width: text Home + Settings on the left, tools on the right
                        ZStack {
                            // 🧱 Left side: Home + Settings menu
                            HStack(spacing: 12) {
                                // Home / back
                                Button {
                                    dismiss()
                                } label: {
                                    Text("Home")
                                        .font(.headline)
                                        .foregroundColor(toolbarTextColor)
                                        .padding(.horizontal, 10)
                                        .padding(.vertical, 6)
                                        .background(
                                            Color.gray.opacity(isDarkUI ? 0.35 : 0.18)
                                        )
                                        .clipShape(Capsule())
                                }
                                
                                // Settings menu next to Home
                                Menu {
                                    Button("Export Page") {
                                        exportTrigger += 1
                                    }
                                    
                                    // 🔹 NEW: Rename Page
                                       Button("Rename Page") {
                                           onRenameRequested()
                                       }
                                    
                                    Button("Clear Page", role: .destructive) {
                                        showClearAlert = true
                                    }
                                } label: {
                                    Text("Settings")
                                        .font(.headline)
                                        .foregroundColor(toolbarTextColor)
                                        .padding(.horizontal, 10)
                                        .padding(.vertical, 6)
                                        .background(
                                            Color.gray.opacity(isDarkUI ? 0.35 : 0.18)
                                        )
                                        .clipShape(Capsule())
                                }
                                if canShowPagesButton {
                                    Button {
                                        withAnimation(.easeInOut(duration: 0.2)) {
                                            isPageStripVisible.toggle()
                                        }
                                    } label: {
                                        Text("Pages")
                                            .font(.headline)
                                            .foregroundColor(toolbarTextColor)
                                            .padding(.horizontal, 10)
                                            .padding(.vertical, 6)
                                            .background(
                                                isPageStripVisible
                                                ? Color.blue.opacity(isDarkUI ? 0.35 : 0.18)
                                                : Color.gray.opacity(isDarkUI ? 0.35 : 0.18)
                                            )
                                            .clipShape(Capsule())
                                    }
                                }
                                
                                Spacer()
                            }
                            .padding(.horizontal)
                            
                            // 🎨 Right side: drawing tools (pen, eraser, undo, redo, color picker)
                            HStack(spacing: 12) {
                                Spacer()
                                
                                // Multiply pen
                                Button {
                                    isErasing = false
                                    useMultiplyPen = true
                                } label: {
                                    Image(systemName: "pencil.tip")
                                        .font(.title2)
                                        .foregroundColor(toolbarIconColor)
                                        .padding(6)
                                        .background(
                                            (!isErasing && useMultiplyPen)
                                            ? Color.gray.opacity(0.2)
                                            : Color.clear
                                        )
                                        .clipShape(Circle())
                                }
                                
                                // (Normal pen still commented out if you don’t want it)
                                Button {
                                    isErasing = false
                                    useMultiplyPen = false
                                } label: {
                                    Image(systemName: "highlighter")
                                        .font(.title2)
                                        .foregroundColor(toolbarIconColor)
                                        .padding(6)
                                        .background(
                                            (!isErasing && !useMultiplyPen)
                                            ? Color.gray.opacity(0.2)
                                            : Color.clear
                                        )
                                        .clipShape(Circle())
                                }
                                
                                // Eraser
                                Button {
                                    isErasing = true
                                } label: {
                                    Image(systemName: "eraser")
                                        .font(.title2)
                                        .foregroundColor(toolbarIconColor)
                                        .padding(6)
                                        .background(
                                            isErasing
                                            ? Color.gray.opacity(0.2)
                                            : Color.clear
                                        )
                                        .clipShape(Circle())
                                }
                                
                                // Undo
                                Button {
                                    performUndo()
                                } label: {
                                    Image(systemName: "arrow.uturn.backward")
                                        .font(.title2)
                                    // .foregroundColor(toolbarIconColor)
                                        .padding(6)
                                }
                                .disabled(lines.isEmpty)
                                
                                
                                // Redo
                                Button {
                                    performRedo()
                                } label: {
                                    Image(systemName: "arrow.uturn.forward")
                                        .font(.title2)
                                        .foregroundColor(toolbarIconColor)
                                        .padding(6)
                                }
                                .disabled(redoStack.isEmpty)
                                
                                Button {
                                    canvasRotationSteps = (canvasRotationSteps + 1) % 4
                                } label: {
                                    Image(systemName: "rotate.right")
                                        .font(.title2)
                                        .foregroundColor(toolbarIconColor)
                                        .padding(6)
                                        .background(Color.gray.opacity(0.2))
                                        .clipShape(Circle())
                                }
                                
                                // Color picker
                                ColorPicker(selection: $selectedColor, supportsOpacity: true) {
                                    Image(systemName: "eyedropper.halffull")
                                        .font(.title2)
                                        .foregroundColor(toolbarIconColor)
                                        .padding(6)
                                        .background(Color.gray.opacity(0.2))
                                        .clipShape(RoundedRectangle(cornerRadius: 8))
                                }
                                .labelsHidden()
                            }
                            .padding(.horizontal)
                        }
                        .padding(.vertical, 8)
                        .frame(maxWidth: .infinity)
                        .background(
                            (isDarkUI
                             ? Color.cosyDarkBackground.opacity(0.95)
                             : Color(UIColor.systemBackground).opacity(0.95)
                            )
                            .ignoresSafeArea(edges: .top)
                        )
                        .zIndex(1)
                    }
                    
                    
                    
                    // MARK: - Slider on the left + Canvas on the right
                    
                    
                    HStack(spacing: 0) {
                        // Left sidebar with vertical brush size slider
                        VStack {
                            Spacer()
                            
                            Slider(
                                value: $brushSize,
                                in: 1...30,
                                step: 1
                            ) {
                                Text("Brush Size")
                            } minimumValueLabel: {
                                Image(systemName: "circle.fill")
                                    .font(.caption2)
                            } maximumValueLabel: {
                                Image(systemName: "circle.fill")
                                    .font(.title3)
                            }
                            // Long horizontal slider, then rotated
                            .frame(width: 240)              // length of the slider track
                            .rotationEffect(.degrees(-90))  // make it vertical
                            .padding(.vertical, 14)
                            
                            Spacer()
                        }
                        
                        // 🔹 narrower sidebar on iPhone, original on iPad
                        .frame(width: isCompact ? 28 : 64)
                        
                        ZoomableDrawingCanvas(
                            lines: $lines,
                            backgroundImage: backgroundImage,
                            selectedColor: selectedColor,
                            isErasing: isErasing,
                            useMultiplyPen: useMultiplyPen,
                            brushSize: CGFloat(brushSize),
                            rotationSteps: canvasRotationSteps,
                            exportTrigger: $exportTrigger,
                            onExport: { image in
                                exportedImage = image
                                isShowingShareSheet = true
                            }
                        )
                        .padding()
                        
                    }
                    .zIndex(0)
                }
            }
            .toolbar(.hidden, for: .navigationBar)
            .onAppear {
                lastLinesCount = lines.count
            }
            
            .onChange(of: lines.count) { newCount in
                // If the user drew a NEW stroke, clear redo history
                if !isPerformingUndoRedo, newCount > lastLinesCount {
                    redoStack.removeAll()
                }
                
                lastLinesCount = newCount
                isPerformingUndoRedo = false
            }
            
            .onAppear {
                // restore last selected color
                selectedColor = Color(
                    red: lastColorR,
                    green: lastColorG,
                    blue: lastColorB,
                    opacity: lastColorA
                )
                
                lastLinesCount = lines.count
            }
            .onChange(of: selectedColor) { newColor in
                // save whenever user picks a new color
                let cc = CodableColor(from: newColor)
                lastColorR = cc.red
                lastColorG = cc.green
                lastColorB = cc.blue
                lastColorA = cc.alpha
            }
            
            
            .sheet(isPresented: $isShowingShareSheet) {
                if let image = exportedImage {
                    ActivityView(activityItems: [image])
                } else {
                    Text("Nothing to share")
                }
            }
            
            .alert("Save and share your colouring", isPresented: $showPhotoSaveInfo) {
                Button("Continue") {
                    hasSeenPhotoSaveInfo = true
                    exportTrigger += 1   // now actually trigger the snapshot + share sheet
                }
                Button("Cancel", role: .cancel) { }
            } message: {
                Text("Colourful can save your finished colouring pages to your photo library so you can share or print them.")
            }
            
            
            .alert("Clear this page?", isPresented: $showClearAlert) {
                Button("Clear", role: .destructive) {
                    lines = []
                    redoStack.removeAll()
                    lastLinesCount = 0
                    isPerformingUndoRedo = false
                    
                }
                Button("Cancel", role: .cancel) { }
            } message: {
                Text("This will remove all your strokes on this page. This cannot be undone.")
            }
        }
        
        // MARK: - Buttons
        
        @ViewBuilder
        func colorButton(color: Color) -> some View {
            Button {
                selectedColor = color
                isErasing = false   // switch back to pencil when picking a color
                // leave useMultiplyPen as-is
            } label: {
                Image(systemName: "circle.fill")
                    .font(.largeTitle)
                    .foregroundColor(color)
                    .mask {
                        Image(systemName: "pencil.tip")
                            .font(.largeTitle)
                    }
            }
        }
        
        @ViewBuilder
        func clearButton() -> some View {
            Button {
                showClearAlert = true   // 👈 show the alert instead of clearing directly
            } label: {
                Text("Clear")
                    .font(.headline)
                    .padding(.horizontal, 12)
                    .padding(.vertical, 6)
                    .background(Color.gray.opacity(0.2))
                    .foregroundColor(toolbarTextColor)
                    .clipShape(Capsule())
            }
        }
        
        // MARK: - Undo / Redo helpers
        
        private func performUndo() {
            guard let last = lines.popLast() else { return }
            isPerformingUndoRedo = true
            redoStack.append(last)
        }
        
        private func performRedo() {
            guard let line = redoStack.popLast() else { return }
            isPerformingUndoRedo = true
            lines.append(line)
        }
        
    }
    
    
    
    // MARK: - ActivityView (Share Sheet)
    
    struct ActivityView: UIViewControllerRepresentable {
        let activityItems: [Any]
        let applicationActivities: [UIActivity]? = nil
        
        func makeUIViewController(context: Context) -> UIActivityViewController {
            UIActivityViewController(
                activityItems: activityItems,
                applicationActivities: applicationActivities
            )
        }
        
        func updateUIViewController(_ uiViewController: UIActivityViewController,
                                    context: Context) {
            // nothing to update
        }
    }
    
    // MARK: - UIKit Zoomable Drawing Canvas (optimized)
    
    final class DrawingCanvasUIView: UIView {
        
        // MARK: - Public model coming from SwiftUI
        var lines: [Line] = [] {
            didSet {
                guard lines != oldValue else { return }
                guard !suppressRebuild else { return }
                
                // If bounds aren't ready yet, delay rebuild
                if bounds.width <= 0 || bounds.height <= 0 {
                    needsRebuildAfterLayout = true
                    setNeedsLayout()
                    return
                }
                
                rebuildStrokeLayersFromLines()
            }
        }
        
        
        
        
        /// Avoid rebuilding layers when we’re just appending a new stroke locally.
        /// Only SwiftUI-driven updates (like undo/redo, loading a new page) will
        /// trigger a full rebuild.
        private var suppressRebuild = false
        
        private var needsRebuildAfterLayout = false
        
        
        
        /// Current brush size (used only for *new* strokes)
        var lineWidth: CGFloat = 7
        
        /// 0,1,2,3 => 0°, 90°, 180°, 270°
        var rotationSteps: Int = 0 {
            didSet { applyRotationTransform() }
        }
        
        
        var strokeColor: UIColor = .orange
        var isErasing: Bool = false
        var useMultiply: Bool = false
        
        var backgroundImage: UIImage? {
            didSet {
                backgroundImageView.image = backgroundImage
                
                // If we already have a real size, rebuild now; otherwise rebuild after layout
                if bounds.width > 0, bounds.height > 0 {
                    rebuildStrokeLayersFromLines()
                } else {
                    needsRebuildAfterLayout = true
                    setNeedsLayout()
                }
            }
        }
        
        
        // Callback to push updated lines back to SwiftUI
        var onLinesChanged: (([Line]) -> Void)?
        
        func requestRebuildAfterLayout() {
            needsRebuildAfterLayout = true
            setNeedsLayout()
        }
        
        // MARK: - Internal views/layers
        
        private let backgroundImageView = UIImageView()
        
        /// Container for "under line art" strokes (multiply)
        private let multiplyStrokesContainerView = UIView()
        
        /// Container for normal strokes
        private let normalStrokesContainerView = UIView()
        
        
        // In-progress stroke
        private var currentPoints: [CGPoint] = []
        private var currentStrokeLayer: CAShapeLayer?
        
        // keep one live path during the stroke (no rebuilding every move)
        private var currentBezierPath = UIBezierPath()
        
        private let contentContainerView = UIView()
        
        
        private var lastLaidOutSize: CGSize = .zero
        
        
       

        
        
        
        // MARK: - Init
        
        override init(frame: CGRect) {
            super.init(frame: frame)
            isMultipleTouchEnabled = false       // 1-finger drawing; 2-finger pan/zoom handled by scroll view
            backgroundColor = .clear
            
            setupViews()
        }
        
        required init?(coder: NSCoder) {
            fatalError("init(coder:) has not been implemented")
        }
        
        
        override func layoutSubviews() {
            super.layoutSubviews()

            let sizeChanged =
                abs(bounds.width - lastLaidOutSize.width) > 0.5 ||
                abs(bounds.height - lastLaidOutSize.height) > 0.5

            if sizeChanged {
                lastLaidOutSize = bounds.size
            }

            applyRotationTransform()

            // Don't rebuild immediately — wait for Auto Layout to finish
            if bounds.width > 0,
               bounds.height > 0,
               (needsRebuildAfterLayout || sizeChanged) {
                needsRebuildAfterLayout = false
                
                // Delay rebuild until after layout pass completes
                DispatchQueue.main.async { [weak self] in
                    self?.rebuildStrokeLayersFromLines()
                }
            }
        }

        
        
        // MARK: - View hierarchy setup
        
        
        
        private func setupViews() {
            // A scale container UIView that holds everything (image + strokes)
            let scaleContainer = UIView()
            scaleContainer.backgroundColor = .clear
            scaleContainer.translatesAutoresizingMaskIntoConstraints = false
            addSubview(scaleContainer)

            NSLayoutConstraint.activate([
                scaleContainer.leadingAnchor.constraint(equalTo: leadingAnchor),
                scaleContainer.trailingAnchor.constraint(equalTo: trailingAnchor),
                scaleContainer.topAnchor.constraint(equalTo: topAnchor),
                scaleContainer.bottomAnchor.constraint(equalTo: bottomAnchor)
            ])
            self.contentContainerView.removeFromSuperview()
            self.contentContainerView.translatesAutoresizingMaskIntoConstraints = false
            scaleContainer.addSubview(contentContainerView)
            NSLayoutConstraint.activate([
                contentContainerView.leadingAnchor.constraint(equalTo: scaleContainer.leadingAnchor),
                contentContainerView.trailingAnchor.constraint(equalTo: scaleContainer.trailingAnchor),
                contentContainerView.topAnchor.constraint(equalTo: scaleContainer.topAnchor),
                contentContainerView.bottomAnchor.constraint(equalTo: scaleContainer.bottomAnchor)
            ])

            // MARK: -  Add subviews in proper order
            // background at back → multiply strokes → normal strokes
            backgroundImageView.translatesAutoresizingMaskIntoConstraints = false
            multiplyStrokesContainerView.translatesAutoresizingMaskIntoConstraints = false
            normalStrokesContainerView.translatesAutoresizingMaskIntoConstraints = false

            contentContainerView.addSubview(backgroundImageView)
            contentContainerView.addSubview(multiplyStrokesContainerView)
            contentContainerView.addSubview(normalStrokesContainerView)

            NSLayoutConstraint.activate([
                backgroundImageView.leadingAnchor.constraint(equalTo: contentContainerView.leadingAnchor),
                backgroundImageView.trailingAnchor.constraint(equalTo: contentContainerView.trailingAnchor),
                backgroundImageView.topAnchor.constraint(equalTo: contentContainerView.topAnchor),
                backgroundImageView.bottomAnchor.constraint(equalTo: contentContainerView.bottomAnchor),

                multiplyStrokesContainerView.leadingAnchor.constraint(equalTo: contentContainerView.leadingAnchor),
                multiplyStrokesContainerView.trailingAnchor.constraint(equalTo: contentContainerView.trailingAnchor),
                multiplyStrokesContainerView.topAnchor.constraint(equalTo: contentContainerView.topAnchor),
                multiplyStrokesContainerView.bottomAnchor.constraint(equalTo: contentContainerView.bottomAnchor),

                normalStrokesContainerView.leadingAnchor.constraint(equalTo: contentContainerView.leadingAnchor),
                normalStrokesContainerView.trailingAnchor.constraint(equalTo: contentContainerView.trailingAnchor),
                normalStrokesContainerView.topAnchor.constraint(equalTo: contentContainerView.topAnchor),
                normalStrokesContainerView.bottomAnchor.constraint(equalTo: contentContainerView.bottomAnchor)
            ])

            // Configure base views
            backgroundImageView.contentMode = .scaleAspectFit
            backgroundImageView.clipsToBounds = true
            backgroundImageView.isUserInteractionEnabled = false
            multiplyStrokesContainerView.isUserInteractionEnabled = false
            normalStrokesContainerView.isUserInteractionEnabled = false

            backgroundImageView.backgroundColor = .clear
            multiplyStrokesContainerView.backgroundColor = .clear
            normalStrokesContainerView.backgroundColor = .clear

            multiplyStrokesContainerView.layer.compositingFilter = "multiplyBlendMode"
            multiplyStrokesContainerView.layer.shouldRasterize = true
            multiplyStrokesContainerView.layer.rasterizationScale = UIScreen.main.scale
            normalStrokesContainerView.layer.shouldRasterize = true
            normalStrokesContainerView.layer.rasterizationScale = UIScreen.main.scale
        }

        
        private func applyRotationTransform() {
            let steps = rotationSteps % 4
            let angle = CGFloat(steps) * (.pi / 2)
            
            var t = CGAffineTransform(rotationAngle: angle)
            
            // when rotated 90/270, scale down so rotated rect still fits
            if steps % 2 == 1, bounds.width > 0, bounds.height > 0 {
                let w = bounds.width
                let h = bounds.height
                let scale = min(w / h, h / w)
                t = t.scaledBy(x: scale, y: scale)
            }
            
            contentContainerView.transform = t
            
          
        }
        
        private let legacyPageStripReservedHeight: CGFloat = 84

        private func fittedCanvasSize(for containerSize: CGSize, imageSize: CGSize) -> CGSize {
            guard containerSize.width > 0,
                  containerSize.height > 0,
                  imageSize.width > 0,
                  imageSize.height > 0 else {
                return .zero
            }

            let imageAspect = imageSize.width / imageSize.height
            let viewAspect = containerSize.width / containerSize.height

            if imageAspect > viewAspect {
                return CGSize(
                    width: containerSize.width,
                    height: containerSize.width / imageAspect
                )
            } else {
                return CGSize(
                    width: containerSize.height * imageAspect,
                    height: containerSize.height
                )
            }
        }
        
        private var currentStoredLineWidth: CGFloat = 7

        private func renderedLineWidth(forStoredWidth storedWidth: CGFloat,
                                       pointSpace: PointSpace) -> CGFloat {
            switch pointSpace {
            case .imageNormalized, .legacyViewNormalized:
                return storedWidth * legacyWidthCompatibilityScale
            case .viewPoints:
                return storedWidth
            }
        }

        private func clampedDrawingPoint(from touch: UITouch) -> CGPoint {
            let raw = touch.location(in: contentContainerView)

            guard backgroundImage != nil else { return raw }

            let r = imageDrawRect
            guard r.width > 0, r.height > 0 else { return raw }

            return CGPoint(
                x: min(max(raw.x, r.minX), r.maxX),
                y: min(max(raw.y, r.minY), r.maxY)
            )
        }

        private var legacyWidthCompatibilityScale: CGFloat {
            guard let img = backgroundImage,
                  let scrollView = superview as? UIScrollView else {
                return 1.0
            }

            let currentContainer = scrollView.bounds.size
            guard currentContainer.width > 0, currentContainer.height > 0 else {
                return 1.0
            }

            let currentFit = fittedCanvasSize(for: currentContainer, imageSize: img.size)

            let legacyContainer = CGSize(
                width: currentContainer.width,
                height: max(1, currentContainer.height - legacyPageStripReservedHeight)
            )
            let legacyFit = fittedCanvasSize(for: legacyContainer, imageSize: img.size)

            guard currentFit.width > 0, legacyFit.width > 0 else {
                return 1.0
            }

            let scale = currentFit.width / legacyFit.width

            // safety clamp so weird layouts do not over-inflate widths
            return min(max(scale, 0.85), 1.35)
        }
        
        
        // MARK: - Coordinate mapping (fix invisible / misaligned legacy strokes)
        
        /// The rect where the background image is actually drawn inside our bounds (because of .scaleAspectFit).
        private var imageDrawRect: CGRect {
            guard let img = backgroundImage,
                  backgroundImageView.bounds.width > 0,
                  backgroundImageView.bounds.height > 0 else {
                return contentContainerView.bounds
            }
            // Use the backgroundImageView's bounds, not contentContainerView
            return AVMakeRect(aspectRatio: img.size, insideRect: backgroundImageView.bounds)
        }

        
        
        /// Heuristic: if points look like 0...1-ish values, treat them as normalized image-space points.
        private func looksNormalized(_ points: [CGPoint]) -> Bool {
            guard let maxX = points.map(\.x).max(),
                  let maxY = points.map(\.y).max() else { return false }
            return maxX <= 1.25 && maxY <= 1.25
        }
        
        private func pointsForRendering(_ line: Line) -> [CGPoint] {
            switch line.pointSpace {
                
            case .imageNormalized:
                guard backgroundImage != nil else { return line.points }
                let r = imageDrawRect
                return line.points.map { p in
                    CGPoint(x: r.minX + (p.x * r.width),
                            y: r.minY + (p.y * r.height))
                }
                
            case .legacyViewNormalized:
                guard backgroundImage != nil else {
                    return line.points.map { CGPoint(x: $0.x * bounds.width, y: $0.y * bounds.height) }
                }
                let r = imageDrawRect
                return line.points.map { p in
                    CGPoint(x: r.minX + (p.x * r.width),
                            y: r.minY + (p.y * r.height))
                }
                
                
            case .viewPoints:
                return line.points
            }
        }
        
        
        // MARK: - Rebuild layers when `lines` is updated from SwiftUI
        
        private func rebuildStrokeLayersFromLines() {
            CATransaction.begin()
            CATransaction.setDisableActions(true)

            multiplyStrokesContainerView.layer.sublayers?.forEach { $0.removeFromSuperlayer() }
            normalStrokesContainerView.layer.sublayers?.forEach { $0.removeFromSuperlayer() }

            for line in lines {
                let uiColor = UIColor(line.color)
                let storedWidth = line.lineWidth ?? lineWidth
                let viewPoints = pointsForRendering(line)

                let adjustedWidth = renderedLineWidth(
                    forStoredWidth: storedWidth,
                    pointSpace: line.pointSpace
                )

                let layer = makeStrokeLayer(
                    for: viewPoints,
                    color: uiColor,
                    lineWidth: adjustedWidth
                )

                if line.isMultiply {
                    multiplyStrokesContainerView.layer.addSublayer(layer)
                } else {
                    normalStrokesContainerView.layer.addSublayer(layer)
                }
            }

            CATransaction.commit()
        }

        
        private func makeStrokeLayer(for points: [CGPoint],
                                     color: UIColor,
                                     lineWidth: CGFloat) -> CAShapeLayer {
            let shapeLayer = CAShapeLayer()
            shapeLayer.fillColor = nil
            shapeLayer.strokeColor = color.cgColor
            shapeLayer.lineWidth = lineWidth
            shapeLayer.lineCap = .round
            shapeLayer.lineJoin = .round
            
            let path = UIBezierPath()
            if let first = points.first {
                path.move(to: first)
                for p in points.dropFirst() {
                    path.addLine(to: p)
                }
            }
            shapeLayer.path = path.cgPath
            
            return shapeLayer
        }
        
        // MARK: - Export snapshot
        
        /// Renders the current canvas (background + strokes) into a UIImage.
        func snapshotImage() -> UIImage {
            let renderer = UIGraphicsImageRenderer(bounds: bounds)
            return renderer.image { ctx in
                layer.render(in: ctx.cgContext)
            }
        }
        
        // MARK: - Touch handling for drawing (1 finger)
        
        override func touchesBegan(_ touches: Set<UITouch>, with event: UIEvent?) {
            guard let touch = touches.first else { return }

            let point = clampedDrawingPoint(from: touch)

            currentPoints = [point]
            currentBezierPath = UIBezierPath()
            currentBezierPath.move(to: point)

            let uiColor = isErasing ? UIColor.white : strokeColor

            let pointSpace: PointSpace = (backgroundImage != nil) ? .imageNormalized : .viewPoints
            currentStoredLineWidth = lineWidth
            let previewWidth = renderedLineWidth(
                forStoredWidth: currentStoredLineWidth,
                pointSpace: pointSpace
            )

            let layer = CAShapeLayer()
            layer.fillColor = nil
            layer.strokeColor = uiColor.cgColor
            layer.lineWidth = previewWidth
            layer.lineCap = .round
            layer.lineJoin = .round
            layer.path = currentBezierPath.cgPath

            if useMultiply {
                multiplyStrokesContainerView.layer.addSublayer(layer)
            } else {
                normalStrokesContainerView.layer.addSublayer(layer)
            }

            currentStrokeLayer = layer
        }
        
        
        override func touchesMoved(_ touches: Set<UITouch>, with event: UIEvent?) {
            guard let touch = touches.first,
                  let layer = currentStrokeLayer else { return }

            let point = clampedDrawingPoint(from: touch)

            if let last = currentPoints.last {
                let dx = point.x - last.x
                let dy = point.y - last.y
                if (dx * dx + dy * dy) < (1.5 * 1.5) { return }
            }

            currentPoints.append(point)

            currentBezierPath.addLine(to: point)
            layer.path = currentBezierPath.cgPath
        }
        
        
        override func touchesEnded(_ touches: Set<UITouch>, with event: UIEvent?) {
            finishStroke()
        }
        
        override func touchesCancelled(_ touches: Set<UITouch>, with event: UIEvent?) {
            finishStroke()
        }
        
        private func finishStroke() {
            guard !currentPoints.isEmpty else { return }

            let uiColor = isErasing ? UIColor.white : strokeColor
            let swiftColor = Color(uiColor: uiColor)

            let storedPoints: [CGPoint] = {
                guard backgroundImage != nil else { return currentPoints }

                let r = imageDrawRect
                guard r.width > 0, r.height > 0 else { return currentPoints }

                return currentPoints.map { p in
                    CGPoint(
                        x: (p.x - r.minX) / r.width,
                        y: (p.y - r.minY) / r.height
                    )
                }
            }()

            let ps: PointSpace = (backgroundImage != nil) ? .imageNormalized : .viewPoints

            let newLine = Line(
                points: storedPoints,
                color: swiftColor,
                isMultiply: useMultiply,
                lineWidth: currentStoredLineWidth,
                pointSpace: ps
            )

            suppressRebuild = true
            lines.append(newLine)
            suppressRebuild = false

            onLinesChanged?(lines)

            currentPoints = []
            currentBezierPath.removeAllPoints()
            currentStrokeLayer = nil
        }
        
    }
    
    // This UIScrollView provides Procreate-style pinch-zoom + pan.
    // 1 finger = drawing (goes to DrawingCanvasUIView).
    // 2 fingers = pan/zoom (handled by the scroll view).
    final class ZoomableDrawingScrollView: UIScrollView, UIScrollViewDelegate {
        
        let drawingView = DrawingCanvasUIView()
        
        override init(frame: CGRect) {
            super.init(frame: frame)
            
            delegate = self
            showsVerticalScrollIndicator = false
            showsHorizontalScrollIndicator = false
            bouncesZoom = true
            bounces = true
            minimumZoomScale = 0.8
            maximumZoomScale = 5.0
            
            // Critical: only start panning with 2 fingers, so 1 finger goes to drawing
            panGestureRecognizer.minimumNumberOfTouches = 2
            
            addSubview(drawingView)
        }
        
        required init?(coder: NSCoder) {
            fatalError("init(coder:) has not been implemented")
        }
        
        override func layoutSubviews() {
            super.layoutSubviews()
            
            guard bounds.width.isFinite, bounds.height.isFinite,
                  bounds.width > 0, bounds.height > 0 else { return }
            
            // Only refit when basically not zoomed
            if abs(zoomScale - 1.0) < 0.0001 {
                guard let img = drawingView.backgroundImage else {
                    if drawingView.frame.size != bounds.size || drawingView.frame.origin != .zero {
                        drawingView.frame = CGRect(origin: .zero, size: bounds.size)
                        contentSize = bounds.size
                        centerContentIfNeeded()
                        drawingView.requestRebuildAfterLayout()
                    }
                    return
                }
                
                let imageAspect = img.size.width / img.size.height
                let viewAspect = bounds.width / bounds.height
                
                let targetSize: CGSize
                if imageAspect > viewAspect {
                    targetSize = CGSize(
                        width: bounds.width,
                        height: bounds.width / imageAspect
                    )
                } else {
                    targetSize = CGSize(
                        width: bounds.height * imageAspect,
                        height: bounds.height
                    )
                }
                
                drawingView.frame = CGRect(origin: .zero, size: targetSize)
                contentSize = targetSize
                centerContentIfNeeded()
                drawingView.requestRebuildAfterLayout()
            } else {
                centerContentIfNeeded()
            }
        }
        
        private func centerContentIfNeeded() {
            let horizontalInset = max(0, (bounds.width - contentSize.width) / 2)
            let verticalInset = max(0, (bounds.height - contentSize.height) / 2)
            contentInset = UIEdgeInsets(
                top: verticalInset,
                left: horizontalInset,
                bottom: verticalInset,
                right: horizontalInset
            )
        }
        
        func viewForZooming(in scrollView: UIScrollView) -> UIView? {
            drawingView
        }
        
        func scrollViewDidZoom(_ scrollView: UIScrollView) {
            centerContentIfNeeded()
        }
    }
    // SwiftUI wrapper around the UIKit scroll+drawing combo.
    struct ZoomableDrawingCanvas: UIViewRepresentable {
        
        @Binding var lines: [Line]
        var backgroundImage: UIImage?
        var selectedColor: Color
        var isErasing: Bool
        var useMultiplyPen: Bool
        var brushSize: CGFloat
        
        var rotationSteps: Int
        
        // 🔹 Export trigger & callback
        @Binding var exportTrigger: Int
        var onExport: (UIImage) -> Void
        
        func makeCoordinator() -> Coordinator {
            Coordinator(parent: self)
        }
        
        func makeUIView(context: Context) -> ZoomableDrawingScrollView {
            let scrollView = ZoomableDrawingScrollView()
            
            // Initial configuration
            scrollView.drawingView.lines = lines
            scrollView.drawingView.backgroundImage = backgroundImage
            scrollView.drawingView.strokeColor = UIColor(selectedColor)
            scrollView.drawingView.isErasing = isErasing
            scrollView.drawingView.useMultiply = useMultiplyPen
            scrollView.drawingView.lineWidth = brushSize
            scrollView.drawingView.rotationSteps = rotationSteps
            
            
            let coordinator = context.coordinator
            
            scrollView.drawingView.onLinesChanged = { [weak coordinator] updatedLines in
                guard let coordinator else { return }
                
                
                coordinator.pendingLinesSkips += 1
                
                // Push into SwiftUI binding (main thread safe)
                DispatchQueue.main.async {
                    coordinator.parent.lines = updatedLines
                }
            }
            
            // Keep a reference so we can snapshot later (not strictly needed now, but handy)
            context.coordinator.scrollView = scrollView
            
            return scrollView
        }
        
        func updateUIView(_ scrollView: ZoomableDrawingScrollView, context: Context) {
            context.coordinator.parent = self
            
            //  apply background first
            scrollView.drawingView.backgroundImage = backgroundImage
            
            // Only sync lines into UIKit if this update did NOT originate from UIKit
            if context.coordinator.pendingLinesSkips > 0 {
                context.coordinator.pendingLinesSkips -= 1
            } else {
                //  lines AFTER background
                scrollView.drawingView.lines = lines
            }
            
            // Keep the rest in sync
            scrollView.drawingView.strokeColor = UIColor(selectedColor)
            scrollView.drawingView.isErasing = isErasing
            scrollView.drawingView.useMultiply = useMultiplyPen
            scrollView.drawingView.lineWidth = brushSize
            scrollView.drawingView.rotationSteps = rotationSteps
            
            
            
            // Check if export was requested
            if context.coordinator.lastExportTrigger != exportTrigger {
                context.coordinator.lastExportTrigger = exportTrigger
                let image = scrollView.drawingView.snapshotImage()
                DispatchQueue.main.async {
                    onExport(image)
                }
            }
        }
        
        
        class Coordinator {
            var parent: ZoomableDrawingCanvas
            
            // Optional: reference to scrollView if needed
            weak var scrollView: ZoomableDrawingScrollView?
            
            // Track last export trigger value so we only export when it changes
            var lastExportTrigger: Int = 0
            
            // how many SwiftUI updates to ignore syncing lines back into UIKit
            var pendingLinesSkips: Int = 0
            
            
            init(parent: ZoomableDrawingCanvas) {
                self.parent = parent
            }
        }
    }
}
