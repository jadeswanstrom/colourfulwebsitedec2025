extension Color {
   /// Cozy dark grey for dark mode UI (not pure black)
   static let cosyDarkBackground = Color(red: 0.10, green: 0.10, blue: 0.12)
}


// MARK: - Codable Color Helper

struct CodableColor: Codable, Equatable {
   let red: Double
   let green: Double
   let blue: Double
   let alpha: Double

   init(from color: Color) {
       let uiColor = UIColor(color)
       var r: CGFloat = 0
       var g: CGFloat = 0
       var b: CGFloat = 0
       var a: CGFloat = 0

       uiColor.getRed(&r, green: &g, blue: &b, alpha: &a)

       red = Double(r)
       green = Double(g)
       blue = Double(b)
       alpha = Double(a)
   }

   var color: Color {
       Color(red: red, green: green, blue: blue, opacity: alpha)
   }
}


enum PointSpace: String, Codable {
    case viewPoints            // absolute points in view coords
    case legacyViewNormalized   // 0...1 relative to full view bounds (old versions)
    case imageNormalized        // 0...1 relative to imageDrawRect (new system)
}

extension CodableColor {
    init(red: Double, green: Double, blue: Double, alpha: Double) {
        self.red = red
        self.green = green
        self.blue = blue
        self.alpha = alpha
    }
}


// MARK: - Models

struct Line: Codable, Equatable {
   var points: [CGPoint]
   private var storedColor: CodableColor
    
    var pointSpace: PointSpace


   /// Should this stroke be drawn in multiply mode (under line art)?
   var isMultiply: Bool

   /// Per-stroke width so old strokes don’t resize when the brush size changes
   var lineWidth: CGFloat?   // optional so old saved data still decodes

   // Public Color wrapper
   var color: Color {
       get { storedColor.color }
       set { storedColor = CodableColor(from: newValue) }
   }

    init(points: [CGPoint],
         color: Color,
         isMultiply: Bool = false,
         lineWidth: CGFloat? = nil,
         pointSpace: PointSpace = .viewPoints) {
        self.points = points
        self.storedColor = CodableColor(from: color)
        self.isMultiply = isMultiply
        self.lineWidth = lineWidth
        self.pointSpace = pointSpace
    }

   // MARK: - Codable (backwards compatible)

    enum CodingKeys: String, CodingKey {
        case points
        case storedColor
        case color
        case isMultiply
        case lineWidth
        case pointSpace
    }


    init(from decoder: Decoder) throws {
        let container = try decoder.container(keyedBy: CodingKeys.self)

        // Decode points into a local var first (avoids capturing self)
        let decodedPoints = (try? container.decode([CGPoint].self, forKey: .points)) ?? []
        self.points = decodedPoints

        // Decode pointSpace safely WITHOUT a closure that touches self
        if let ps = try? container.decode(PointSpace.self, forKey: .pointSpace) {
            self.pointSpace = ps
        } else {
            // Legacy fallback: if points look 0...1, they were normalized to FULL view bounds
            let maxX = decodedPoints.map(\.x).max() ?? 0
            let maxY = decodedPoints.map(\.y).max() ?? 0
            self.pointSpace = (maxX <= 1.25 && maxY <= 1.25) ? .legacyViewNormalized : .viewPoints
        }

        // Decode storedColor (new) or legacy color, or fallback
        if let sc = try? container.decode(CodableColor.self, forKey: .storedColor) {
            self.storedColor = sc
        } else if let legacy = try? container.decode(CodableColor.self, forKey: .color) {
            self.storedColor = legacy
        } else {
            self.storedColor = CodableColor(from: .black)
        }

        self.isMultiply = (try? container.decode(Bool.self, forKey: .isMultiply)) ?? false
        self.lineWidth = try? container.decode(CGFloat.self, forKey: .lineWidth)
    }

    
   func encode(to encoder: Encoder) throws {
       var container = encoder.container(keyedBy: CodingKeys.self)

       try container.encode(points, forKey: .points)
       try container.encode(storedColor, forKey: .storedColor)
       try container.encode(isMultiply, forKey: .isMultiply)
       try container.encode(lineWidth, forKey: .lineWidth)
       try container.encode(pointSpace, forKey: .pointSpace)

   }
}



struct ColoringPage: Codable, Identifiable {
   var id: UUID
   var name: String
   var lines: [Line]

   // NEW: stored in UserDefaults
   var backgroundImageFilename: String?

   // Runtime-only cache (not encoded)
   var backgroundImageData: Data?

   init(id: UUID = UUID(),
        name: String,
        lines: [Line],
        backgroundImageFilename: String? = nil,
        backgroundImageData: Data? = nil) {
       self.id = id
       self.name = name
       self.lines = lines
       self.backgroundImageFilename = backgroundImageFilename
       self.backgroundImageData = backgroundImageData
   }

   enum CodingKeys: String, CodingKey {
       case id
       case name
       case lines
       case backgroundImageFilename   // 👈 persisted
       // backgroundImageData is NOT encoded
   }
}



// MARK: - Root ContentView


struct ContentView: View {
   // Track when the app became active
   @State private var lastActiveDate: Date? = nil
   
   // Watch app lifecycle (foreground / background)
   @Environment(\.scenePhase) private var scenePhase

   var body: some View {
       HomeView()
           .onChange(of: scenePhase) { newPhase in
               switch newPhase {
               case .active:
                   lastActiveDate = Date()

               case .inactive, .background:
                   if let start = lastActiveDate {
                       let elapsed = Date().timeIntervalSince(start)
                       AppReviewManager.trackPlaytime(seconds: elapsed)
                       lastActiveDate = nil
                   }

               @unknown default:
                   break
               }
           }
   }
}

struct ContentView_Previews: PreviewProvider {
   static var previews: some View {
       ContentView()
   }
}



// MARK: - PDF Rendering Helper (ANY page)

// Render a specific page of a PDFDocument into a UIImage.
// This version *forces* the final image to be landscape (width >= height)
// by rotating portrait pages 90°.
func renderPage(of pdfDoc: PDFDocument,
               pageIndex: Int,
               maxDimension: CGFloat = 1500) -> UIImage? {
   guard let page = pdfDoc.page(at: pageIndex),
         let cgPage = page.pageRef else {
       return nil
   }

   // Raw media box of the PDF page
   let mediaRect = cgPage.getBoxRect(.mediaBox)

   // PDF's own rotation (0, 90, 180, 270)
   let baseRotation = page.rotation
   let baseIsSideways = baseRotation % 180 != 0

   // Dimensions AFTER the PDF's own rotation is applied
   let baseWidth: CGFloat  = baseIsSideways ? mediaRect.height : mediaRect.width
   let baseHeight: CGFloat = baseIsSideways ? mediaRect.width  : mediaRect.height

   // If it's portrait after base rotation, add 90° to make it landscape
   let needsExtraRotation = baseHeight > baseWidth
   let extraRotation: Int32 = needsExtraRotation ? 90 : 0

   // Final orientation = PDF’s rotation + our extra
   let totalRotation = (baseRotation + Int(extraRotation)) % 360
   let finalIsSideways = totalRotation % 180 != 0

   // Logical width/height of the final page on screen
   let logicalWidth: CGFloat  = finalIsSideways ? mediaRect.height : mediaRect.width
   let logicalHeight: CGFloat = finalIsSideways ? mediaRect.width  : mediaRect.height

   // Scale to fit within maxDimension
   let scale = min(maxDimension / logicalWidth,
                   maxDimension / logicalHeight)

   let targetSize = CGSize(
       width: logicalWidth * scale,
       height: logicalHeight * scale
   )
   let drawRect = CGRect(origin: .zero, size: targetSize)

   UIGraphicsBeginImageContextWithOptions(targetSize, true, 0.0)
   guard let ctx = UIGraphicsGetCurrentContext() else {
       UIGraphicsEndImageContext()
       return nil
   }

   // White paper background
   UIColor.white.setFill()
   ctx.fill(drawRect)

   // Fixes the mirroring:
   // UIKit's context has origin at top-left (y going down),
   // but PDF coordinates are bottom-left (y going up).
   // Flip the context into PDF-style coordinates first.
   ctx.translateBy(x: 0, y: targetSize.height)
   ctx.scaleBy(x: 1, y: -1)

   // Let CoreGraphics handle the page transform, using ONLY our extraRotation.
   // PDF's own /Rotate is already baked into cgPage + mediaBox.
   let transform = cgPage.getDrawingTransform(
       .mediaBox,
       rect: drawRect,
       rotate: extraRotation,
       preserveAspectRatio: true
   )

   ctx.concatenate(transform)
   ctx.drawPDFPage(cgPage)

   // Get the rendered image
   guard let baseImage = UIGraphicsGetImageFromCurrentImageContext(),
         let cg = baseImage.cgImage else {
       UIGraphicsEndImageContext()
       return nil
   }
   UIGraphicsEndImageContext()

   // --- Centered zoom-in via cropping ---

   // How much to zoom:
   // 1.0 = no zoom, 1.05 = slight zoom, 1.1 = stronger zoom
   let zoomFactor: CGFloat = 1.94   // tweak this to taste

   let cgWidth  = CGFloat(cg.width)
   let cgHeight = CGFloat(cg.height)

   // Compute a centered crop rect that is smaller than the full image
   let cropWidth  = cgWidth  / zoomFactor
   let cropHeight = cgHeight / zoomFactor
   let originX = (cgWidth  - cropWidth)  / 2
   let originY = (cgHeight - cropHeight) / 2

   let cropRect = CGRect(
       x: originX,
       y: originY,
       width: cropWidth,
       height: cropHeight
   )

   if let croppedCG = cg.cropping(to: cropRect) {
       // Keep the original orientation + scale
       return UIImage(
           cgImage: croppedCG,
           scale: baseImage.scale,
           orientation: baseImage.imageOrientation
       )
   } else {
       // If cropping fails, fall back to the original image
       return baseImage
   }
}



// MARK: - Persistence Store

class ColoringPagesStore: ObservableObject {
   @Published var pages: [ColoringPage] = []

   private let saveKey = "coloringPages"
   private let backupKey = "coloringPages_backup"
    

   private let saveQueue = DispatchQueue(label: "ColoringPagesStore.save", qos: .utility)
   private var cancellables = Set<AnyCancellable>()

   private let libraryFileName = "coloringPages.json"
   private let libraryBackupFileName = "coloringPages_backup.json"
    
    private let alsoWriteToUserDefaults = false

    private let backupInterval: TimeInterval = 60 * 60 * 24
    private let lastBackupStampKey = "ColoringPagesStore.lastBackupStamp"


   private var libraryFileURL: URL? {
       FileManager.default.urls(for: .documentDirectory, in: .userDomainMask).first?
           .appendingPathComponent(libraryFileName)
   }

   private var libraryBackupFileURL: URL? {
       FileManager.default.urls(for: .documentDirectory, in: .userDomainMask).first?
           .appendingPathComponent(libraryBackupFileName)
   }

   // PUT IT RIGHT HERE (still inside ColoringPagesStore)
   private func savePagesToJSON(_ pagesToSave: [ColoringPage]) {
       do {
           let data = try JSONEncoder().encode(pagesToSave)

           if let url = libraryFileURL {
               try data.write(to: url, options: [.atomic])
           }
       } catch {
           print("❌ Failed to migrate pages to JSON:", error)
       }
   }


   
   
   // MARK: - Background image storage (disk)
   
   /// Subfolder in the app's Documents directory where we store background PNGs.
   private let backgroundsFolderName = "ColoringBackgrounds"
   
   /// The full URL to the backgrounds folder in Documents.
   private var backgroundsFolderURL: URL? {
       let fm = FileManager.default
       guard let docs = fm.urls(for: .documentDirectory, in: .userDomainMask).first else {
           return nil
       }
       return docs.appendingPathComponent(backgroundsFolderName, isDirectory: true)
   }
   
   /// Ensure the backgrounds folder exists. Returns its URL or nil if something failed.
   @discardableResult
   private func ensureBackgroundsFolderExists() -> URL? {
       guard let folderURL = backgroundsFolderURL else { return nil }
       
       let fm = FileManager.default
       if !fm.fileExists(atPath: folderURL.path) {
           do {
               try fm.createDirectory(at: folderURL, withIntermediateDirectories: true, attributes: nil)
           } catch {
               print("❌ Failed to create backgrounds folder:", error)
               return nil
           }
       }
       
       return folderURL
   }
   /// Save a background image as a PNG in our backgrounds folder.
   /// Returns a unique filename we can store in `ColoringPage.backgroundImageFilename`.
   @discardableResult
   private func saveBackground(image: UIImage) -> String? {
       // Make sure we have a folder to save into
       guard let folderURL = ensureBackgroundsFolderExists() else { return nil }
       
       // Convert to PNG data
       guard let data = image.pngData() else {
           print("❌ Failed to convert background image to PNG data")
           return nil
       }
       
       // Generate a unique filename, e.g. "bg-<uuid>.png"
       let filename = "bg-\(UUID().uuidString).png"
       let fileURL = folderURL.appendingPathComponent(filename)
       
       do {
           try data.write(to: fileURL, options: [.atomic])
           // print("Saved background image to:", fileURL.path)
           return filename
       } catch {
           print("❌ Failed to write background PNG to disk:", error)
           return nil
       }
   }
   /// Load the background image for a given page (if one exists on disk).
   func loadBackgroundImage(for page: ColoringPage) -> UIImage? {
       // If we already have in-memory data, use that first:
       if let data = page.backgroundImageData,
          let img = UIImage(data: data) {
           return img
       }
       
       // Otherwise, try loading from the stored filename.
       guard
           let filename = page.backgroundImageFilename,
           let folderURL = backgroundsFolderURL
       else {
           return nil
       }
       
       let fileURL = folderURL.appendingPathComponent(filename)
       
       do {
           let data = try Data(contentsOf: fileURL)
           return UIImage(data: data)
       } catch {
           print("❌ Failed to load background image from disk:", error)
           return nil
       }
   }
   
   
   
   init() {
       load()
       
       // Debounced autosave: saves after the user pauses changes briefly
       $pages
           .dropFirst() // ignore the initial load() assignment
           .debounce(for: .milliseconds(350), scheduler: saveQueue)
           .sink { [weak self] _ in
               self?.saveNow()
           }
           .store(in: &cancellables)
   }
   
    private func groupedBaseName(for pageName: String) -> String {
        if let range = pageName.range(of: " - Page ") {
            return String(pageName[..<range.lowerBound])
        } else {
            return pageName
        }
    }

    private func uniqueBookBaseName(for desiredBaseName: String) -> String {
        let trimmed = desiredBaseName.trimmingCharacters(in: .whitespacesAndNewlines)
        guard !trimmed.isEmpty else { return "Untitled Page" }

        let existingBaseNames = Set(
            pages.map { groupedBaseName(for: $0.name) }
        )

        if !existingBaseNames.contains(trimmed) {
            return trimmed
        }

        var counter = 2
        var candidate = "\(trimmed) (\(counter))"

        while existingBaseNames.contains(candidate) {
            counter += 1
            candidate = "\(trimmed) (\(counter))"
        }

        return candidate
    }
   
   private func load() {
       let decoder = JSONDecoder()
       let fm = FileManager.default

       // 1) NEW storage: Documents/coloringPages.json
       if let url = libraryFileURL,
          fm.fileExists(atPath: url.path),
          let data = try? Data(contentsOf: url),
          let decoded = try? decoder.decode([ColoringPage].self, from: data) {

           pages = decoded

           // INSERT MIGRATION HERE (still inside this if, before return)
           var migrated = false
           for i in pages.indices {
               if pages[i].backgroundImageFilename == nil,
                  let data = pages[i].backgroundImageData,
                  let img = UIImage(data: data),
                  let filename = saveBackground(image: img) {
                   pages[i].backgroundImageFilename = filename
                   migrated = true
                   print("🧪 migrated background to disk for page:", pages[i].name)
               }
           }
           if migrated {
               saveNow() // persist the new filenames
           }

           return
       }

       // 2) NEW backup: Documents/coloringPages_backup.json
       if let url = libraryBackupFileURL,
          fm.fileExists(atPath: url.path),
          let data = try? Data(contentsOf: url),
          let decoded = try? decoder.decode([ColoringPage].self, from: data) {

           pages = decoded

           // INSERT MIGRATION HERE (still inside this if, before return)
           var migrated = false
           for i in pages.indices {
               if pages[i].backgroundImageFilename == nil,
                  let data = pages[i].backgroundImageData,
                  let img = UIImage(data: data),
                  let filename = saveBackground(image: img) {
                   pages[i].backgroundImageFilename = filename
                   migrated = true
                   print("🧪 migrated background to disk for page:", pages[i].name)
               }
           }
           if migrated {
               saveNow()
           }

           return
       }

       // 3) OLD storage: UserDefaults primary
       let defaults = UserDefaults.standard
       if let data = defaults.data(forKey: saveKey),
          let decoded = try? decoder.decode([ColoringPage].self, from: data) {

           pages = decoded

           // NEW: debug print to confirm we actually loaded old pages + lines
           let totalLines = pages.reduce(0) { $0 + $1.lines.count }
           print("✅ Loaded \(pages.count) pages from UserDefaults with \(totalLines) total lines")

           // Background image migration (this is what you already had)
           var migrated = false
           for i in pages.indices {
               if pages[i].backgroundImageFilename == nil,
                  let data = pages[i].backgroundImageData,
                  let img = UIImage(data: data),
                  let filename = saveBackground(image: img) {
                   pages[i].backgroundImageFilename = filename
                   migrated = true
                   print("🧪 migrated background to disk for page:", pages[i].name)
               }
           }
           if migrated {
               saveNow()
           }

           // OPTIONAL: migrate old UserDefaults -> JSON so future loads hit Documents first
           savePagesToJSON(pages)

           return
       }


       // 4) OLD storage: UserDefaults backup
       if let data = defaults.data(forKey: backupKey),
          let decoded = try? decoder.decode([ColoringPage].self, from: data) {

           pages = decoded

           // INSERT MIGRATION HERE (still inside this if, before the JSON migration/return)
           var migrated = false
           for i in pages.indices {
               if pages[i].backgroundImageFilename == nil,
                  let data = pages[i].backgroundImageData,
                  let img = UIImage(data: data),
                  let filename = saveBackground(image: img) {
                   pages[i].backgroundImageFilename = filename
                   migrated = true
                   print("🧪 migrated background to disk for page:", pages[i].name)
               }
           }
           if migrated {
               saveNow()
           }

           // OPTIONAL: migrate old UserDefaults -> JSON backup too
           savePagesToJSON(pages)

           return
       }

       // 5) Nothing found
       seedInitialPages()
   }

   
   // MARK: - DEFAULT FREE COLOURING PAGE
   
   /// Create initial content the very first time the app runs.
   /// This will show up on the Home screen automatically.
   private func seedInitialPages() {
       pages = []
       
       addBundledImagePage(
           named: "Satisfying Ribbons",   // asset name
           fileExtension: "png",       // ignored for assets, but fine to leave
           displayName: "Satisfying Ribbons" // title shown in the grid
       )
       
       addBundledImagePage(
           named: "Sunflower Bee",   // asset name
           fileExtension: "png",       // ignored for assets, but fine to leave
           displayName: "Spring Flowers" // title shown in the grid
       )
       
       addBundledImagePage(
           named: "Cozy Plant Collection",   // asset name
           fileExtension: "png",       // ignored for assets, but fine to leave
           displayName: "Cozy Plant Collection" // title shown in the grid
       )
       
      
       if pages.isEmpty {
           pages = [
               ColoringPage(name: "Sample Page", lines: [])
               
           ]
           
       }
   }
       
       
       
    private func saveNow() {
        do {
            let data = try JSONEncoder().encode(pages)
            let fm = FileManager.default
            
            let totalLines = pages.reduce(0) { $0 + $1.lines.count }
            print("💾 saveNow() pages=\(pages.count) totalLines=\(totalLines)")


            // --- NEW: write JSON to Documents (primary) ---
            if let url = libraryFileURL {

                // Rotate backup only occasionally (once per day)
                let now = Date().timeIntervalSince1970
                let lastBackup = UserDefaults.standard.double(forKey: lastBackupStampKey)

                if now - lastBackup > backupInterval,
                   fm.fileExists(atPath: url.path),
                   let backupURL = libraryBackupFileURL {

                    try? fm.removeItem(at: backupURL)
                    try? fm.copyItem(at: url, to: backupURL)

                    UserDefaults.standard.set(now, forKey: lastBackupStampKey)
                }

                // Atomic write already prevents partial write corruption
                try data.write(to: url, options: [.atomic])
            }

            // Don’t write huge libraries to UserDefaults (keep load fallback only)
            if alsoWriteToUserDefaults {
                if let old = UserDefaults.standard.data(forKey: saveKey) {
                    UserDefaults.standard.set(old, forKey: backupKey)
                }
                UserDefaults.standard.set(data, forKey: saveKey)
            }

        } catch {
            print("Failed to encode pages:", error)
        }
    }


       
       /// Call this when the app is backgrounding to minimize data loss risk
       func forceSave() {
           saveQueue.async { [weak self] in
               self?.saveNow()
           }
       }
       
       
       func addBlankPage() {
           let newIndex = pages.count + 1
           let newPage = ColoringPage(name: "Page \(newIndex)", lines: [])
           pages.append(newPage)
       }
       
       /// Builds ColoringPage objects from a PDF WITHOUT mutating `pages`.
       /// (So we can safely run it on a background thread, then append once on main.)
    private func makePages(fromPDFAt url: URL, displayBaseName: String? = nil) -> [ColoringPage] {
           print("Attempting to open PDF at:", url)
           
           guard let pdfDoc = PDFDocument(url: url) else {
               print("Failed to open PDF")
               return []
           }
           
           let pageCount = pdfDoc.pageCount
           print("PDF opened. Page count:", pageCount)
           
           guard pageCount > 0 else {
               print("PDF has no pages")
               return []
           }
           
        let baseName = displayBaseName ?? url.deletingPathExtension().lastPathComponent
           var built: [ColoringPage] = []
           built.reserveCapacity(pageCount)
           
           for index in 0..<pageCount {
               guard let image = renderPage(of: pdfDoc, pageIndex: index) else {
                   print("Failed to render page \(index + 1)")
                   continue
               }
               
               let pageName: String = (pageCount == 1)
               ? baseName
               : "\(baseName) - Page \(index + 1)"
               
               let filename = saveBackground(image: image)
               
               let newPage = ColoringPage(
                   name: pageName,
                   lines: [],
                   backgroundImageFilename: filename,
                   backgroundImageData: nil
               )
               
               built.append(newPage)
               print("Built page:", pageName, "filename:", filename ?? "nil")
           }
           
           return built
       }
       
       
       /// Import a PDF or image from a FileImporter URL WITHOUT blocking the main thread.
       /// Handles security-scoped access internally so the file stays readable during the background work.
       func importFromFileImporterURL(_ url: URL) {
           DispatchQueue.global(qos: .userInitiated).async { [weak self] in
               guard let self else { return }
               
               // Keep security-scoped access alive for the ENTIRE import
               let gotAccess = url.startAccessingSecurityScopedResource()
               defer {
                   if gotAccess { url.stopAccessingSecurityScopedResource() }
               }
               
               let ext = url.pathExtension.lowercased()
               var newPages: [ColoringPage] = []
               
               if ext == "pdf" {
                   newPages = self.makePages(fromPDFAt: url)
               } else if ["png", "jpg", "jpeg", "heic", "heif"].contains(ext) {
                   if let page = self.makePage(fromImageAt: url) {
                       newPages = [page]
                   }
               } else {
                   print("Unsupported file type:", ext)
               }
               
               // Only touch @Published properties on the MAIN thread
               DispatchQueue.main.async {
                   guard !newPages.isEmpty else { return }
                   self.pages.append(contentsOf: newPages)
               }
           }
       }
       
       func addPage(fromImageData data: Data, named name: String = "Photo Page") {
           guard let image = UIImage(data: data) else {
               print("Failed to decode image data from Photos")
               return
           }
           
           // 1️⃣ Save to disk
           let filename = saveBackground(image: image)
           
           // Make sure each imported photo becomes its own "book"
           let baseName = name
           var finalName = baseName
           var counter = 2
           
           while pages.contains(where: { $0.name == finalName }) {
               finalName = "\(baseName) (\(counter))"
               counter += 1
           }
           
           let newPage = ColoringPage(
               name: finalName,
               lines: [],
               backgroundImageFilename: filename,
               backgroundImageData: nil   //  no big PNG blob in memory
           )
           pages.append(newPage)
           
           print("Added image page from Photos:", finalName, "filename:", filename ?? "nil")
       }
       
       
       
       
       
       /// Builds a single ColoringPage from an image URL WITHOUT mutating `pages`.
       private func makePage(fromImageAt url: URL) -> ColoringPage? {
           print("Attempting to open image at:", url)
           
           guard let data = try? Data(contentsOf: url),
                 let uiImage = UIImage(data: data) else {
               print("Failed to load image at:", url)
               return nil
           }
           
           let filename = saveBackground(image: uiImage)
           let baseName = url.deletingPathExtension().lastPathComponent
           
           let newPage = ColoringPage(
               name: baseName,
               lines: [],
               backgroundImageFilename: filename,
               backgroundImageData: nil
           )
           
           print("Built image page:", baseName, "filename:", filename ?? "nil")
           return newPage
       }
       
       
       
       
    func addPagesFromBundledPDF(named resourceName: String, displayName: String? = nil) {
        guard let url = Bundle.main.url(forResource: resourceName, withExtension: "pdf") else {
            print("Bundled PDF \(resourceName).pdf not found in app bundle")
            return
        }

        let desiredBaseName = displayName ?? resourceName

        DispatchQueue.global(qos: .userInitiated).async { [weak self] in
            guard let self else { return }

            let uniqueBaseName = self.uniqueBookBaseName(for: desiredBaseName)
            let newPages = self.makePages(fromPDFAt: url, displayBaseName: uniqueBaseName)

            DispatchQueue.main.async {
                guard !newPages.isEmpty else { return }
                self.pages.append(contentsOf: newPages)
            }
        }
    }
       
       /// Create new pages from a PDF that is bundled with the app.
       /// `resourceName` is the name of the PDF file *without* the .pdf extension.
    func addBundledImagePage(
        named resourceName: String,
        fileExtension: String = "png",
        displayName: String? = nil
    ) {
        let desiredBaseName = displayName ?? resourceName
        let uniqueName = uniqueBookBaseName(for: desiredBaseName)

        // 1️⃣ First try to load from Assets.xcassets or any compiled image
        if let uiImage = UIImage(named: resourceName) {
            let filename = saveBackground(image: uiImage)

            let newPage = ColoringPage(
                name: uniqueName,
                lines: [],
                backgroundImageFilename: filename,
                backgroundImageData: nil
            )

            pages.append(newPage)
            print("✅ Added bundled image page from UIImage(named:):", uniqueName,
                  "filename:", filename ?? "nil")
            return
        }

        // 2️⃣ Fallback: try to load a raw file from the bundle
        guard let url = Bundle.main.url(forResource: resourceName,
                                        withExtension: fileExtension),
              let data = try? Data(contentsOf: url),
              let uiImage = UIImage(data: data) else {
            print("❌ Failed to load bundled image: \(resourceName).\(fileExtension)")
            return
        }

        let filename = saveBackground(image: uiImage)

        let newPage = ColoringPage(
            name: uniqueName,
            lines: [],
            backgroundImageFilename: filename,
            backgroundImageData: nil
        )

        pages.append(newPage)
        print("✅ Added bundled image page from file:", uniqueName,
              "filename:", filename ?? "nil")
    }
       
   }
   
   
   
   // MARK: - Home Screen with Grid
   
   struct HomeView: View {
       @Environment(\.horizontalSizeClass) private var hSizeClass
       
       @Environment(\.scenePhase) private var scenePhase
       
       
       @StateObject private var store = ColoringPagesStore()
       @State private var showingPDFImporter = false
       
       // delete mode & alert
       @State private var isDeleteMode = false
       @State private var showDeleteAlert = false
       @State private var deleteTargetBaseName: String = ""
       
       // Photos picker state
       @State private var showingPhotoPicker = false
       @State private var selectedPhotoItem: PhotosPickerItem? = nil
       
       // Pre-permission prompts (FILES ONLY)
       @AppStorage("hasSeenFilesImportInfo") private var hasSeenFilesImportInfo: Bool = false
       @State private var showFilesImportInfo = false
       
       // Photos: settings alert (for when user chose “Don’t Allow”)
       @State private var showPhotosSettingsAlert = false
       
       // prevents double-import from a single selection
       @State private var isImportingPhoto = false
       
       // Pro flag (stored in UserDefaults)
       @AppStorage("isProUser") private var isProUser: Bool = false
       
       //  New: UI theme flag (dark vs light UI)
       @AppStorage("isDarkUI") private var isDarkUI: Bool = false
       
       // Pro alert
       @State private var showProLimitAlert = false
       
       // new page options
       @State private var showNewPageOptions = false
       
       
       
       // Pro info popup
       @State private var showProInfo = false
       
       @State private var shouldOpenShop = false
       
       // preventing double-presentations
       @State private var isPresentingSystemPicker = false
       
       
       // Responsive grid: 1 column on iPhone, 3 on iPad
       private var columns: [GridItem] {
           if hSizeClass == .compact {
               // iPhone width
               return [
                   GridItem(.flexible()),
                   
               ]
           } else {
               // iPad or larger
               return [
                   GridItem(.flexible()),
                   GridItem(.flexible()),
                   GridItem(.flexible())
               ]
           }
       }
       
       // Free users can have up to 5 books
       private let freeBookLimit = 5
       
       // Books that should NOT count toward the free limit
       private let limitExemptBookBaseNames: Set<String> = ["Spring Flowers", "Satisfying Ribbons","Cozy Plant Collection"]
       
    
       
       // MARK: - Banner slideshow
       private let bannerImages = ["welcometocolourful", "springupdatebanner", "madebyrealartistsbanner"] // asset names
       @State private var bannerIndex: Int = 0
       
       
       private var canCreateNewBook: Bool {
           isProUser || countedGroupLeaders.count < freeBookLimit
       }
       
       
       private var primaryLabelColor: Color {
           isDarkUI ? .white : .primary
       }
       
       private var secondaryLabelColor: Color {
           isDarkUI ? Color.white.opacity(0.8) : .secondary
       }
       
       private var toolbarIconColor: Color {
           isDarkUI ? .white : .primary
       }
       
       private var proBadgeBackground: Color {
           isDarkUI ? Color.yellow.opacity(0.25) : Color.yellow.opacity(0.3)
       }
       
       // MARK: - Body
       
       var body: some View {
           NavigationStack {
               mainContent
           }
           .onChange(of: scenePhase) { newPhase in
               if newPhase == .inactive || newPhase == .background {
                   store.forceSave()
               }
           }
           .sheet(isPresented: $showProInfo) {
               ProInfoSheet(store: store) {
                   showProInfo = false
                   DispatchQueue.main.asyncAfter(deadline: .now() + 0.35) {
                       shouldOpenShop = true
                   }
               }
           }
       }
       
       
       // MARK: - Home view banner banner size
       
       private var bannerSlideshow: some View {
           TabView(selection: $bannerIndex) {
               ForEach(Array(bannerImages.enumerated()), id: \.offset) { index, name in
                   Image(name)
                       .resizable()
                       .scaledToFill()
                       .tag(index)
                       .clipped()
               }
           }
           .tabViewStyle(.page)                 // swipeable dots
           
           .frame(maxWidth: .infinity)
           
           .frame(height: hSizeClass == .compact ? 100 : 130)
           
           
           
           .clipShape(RoundedRectangle(cornerRadius: 18))
           .shadow(radius: 6, y: 2)
           .onReceive(Timer.publish(every: 8, on: .main, in: .common).autoconnect()) { _ in
               guard !bannerImages.isEmpty else { return }
               withAnimation {
                   bannerIndex = (bannerIndex + 1) % bannerImages.count
               }
           }
       }
       
       
       // MARK: - Main content inside NavigationStack
       
       private var mainContent: some View {
           ZStack {
               
               
               // Scroll + grid
               ScrollView {
                   VStack(spacing: 16) {
                       bannerSlideshow          //  sits under title, above “Start Something New”
                       homeGrid
                   }
                   .padding()
               }
               
               
               // Hidden NavigationLink that activates when `shouldOpenShop` becomes true
               NavigationLink(
                   destination: ShopView(store: store),
                   isActive: $shouldOpenShop
               ) {
                   EmptyView()
               }
               .frame(width: 0, height: 0)      // keep it out of layout
               .opacity(0)                      // invisible
               .allowsHitTesting(false)         //  cannot steal taps
               
           }
           // Theme-aware background just for the *UI*, not the canvas
           .background(
               (isDarkUI ? Color.cosyDarkBackground
                : Color(UIColor.systemGroupedBackground))
               .ignoresSafeArea()
           )
           // Dark mode text integration
           .navigationTitle("My Colouring Pages")
           .toolbar { toolbarContent }
           .toolbarBackground(
               isDarkUI ? Color.cosyDarkBackground : Color(UIColor.systemBackground),
               for: .navigationBar
           )
           .toolbarBackground(.visible, for: .navigationBar)
           .toolbarColorScheme(isDarkUI ? .dark : .light, for: .navigationBar)
           
           // MARK: - Importers
           
           .fileImporter(
               isPresented: $showingPDFImporter,
               allowedContentTypes: [.pdf, .image],
               allowsMultipleSelection: false
           ) { result in
               handleFileImport(result)
           }
           
           .photosPicker(
               isPresented: $showingPhotoPicker,
               selection: $selectedPhotoItem,
               matching: .images
           )
           
           .onChange(of: selectedPhotoItem, perform: handlePhotoPickerChange)
           
           // MARK: - Delete confirmation alert
           
           .alert("Delete this coloring book?", isPresented: $showDeleteAlert) {
               Button("Delete", role: .destructive) {
                   deleteGroup(named: deleteTargetBaseName)
                   deleteTargetBaseName = ""
                   isDeleteMode = false
               }
               Button("Cancel", role: .cancel) {
                   deleteTargetBaseName = ""
               }
           } message: {
               Text("This will delete all pages in this book (or this single page). This cannot be undone.")
           }
           
           // MARK: - Pro limit alert
           
           .alert(isPresented: $showProLimitAlert) {
               Alert(
                   title: Text("Upgrade to Pro to add more books"),
                   message: Text("Free users can have up to \(freeBookLimit) coloring books. Try deleting old books or Upgrade to Pro for unlimited books."),
                   dismissButton: .default(Text("OK"))
               )
           }
           
           // MARK: - One-time pre-prompt for Files (Documents + Downloads)
           
           .alert("Colourful would like to access your files",
                  isPresented: $showFilesImportInfo) {
               Button("Continue") {
                   hasSeenFilesImportInfo = true
                   showingPDFImporter = true   // now actually open the file importer
               }
           } message: {
               Text("""
           Colourful uses access to your Documents folder so you can open and save colouring PDFs and images you choose to use in the app.
           """)
           }
           
           // MARK: - Photos settings guidance (after user has already denied)
           .alert("Photo access needed",
                  isPresented: $showPhotosSettingsAlert) {
               Button("Open Settings") {
                   openAppSettings()
               }
               Button("Cancel", role: .cancel) { }
           } message: {
               Text("""
           To import pictures, please allow photo access for Colourful in Settings ▸ Privacy ▸ Photos.
           """)
           }
       }
       
       // MARK: - Toolbar content
       
       @ToolbarContentBuilder
       private var toolbarContent: some ToolbarContent {
           
           //  New: theme toggle on the left
           ToolbarItem(placement: .navigationBarLeading) {
               Button {
                   isDarkUI.toggle()
               } label: {
                   Image(systemName: isDarkUI ? "sun.max.fill" : "moon.fill")
                       .imageScale(.large)
               }
               .accessibilityLabel(isDarkUI ? "Switch to light mode" : "Switch to dark mode")
           }
           
           // Existing items on the right
           ToolbarItem(placement: .navigationBarTrailing) {
               HStack(spacing: 10) {
                   // Shop button
                   NavigationLink {
                       ShopView(store: store)
                   } label: {
                       HStack(spacing: 6) {
                           Image(systemName: "cart.fill")
                               .imageScale(.small)
                           Text("Colouring Library")
                               .font(.subheadline.weight(.semibold))
                               
                       }
                       .padding(.horizontal, 10)
                       .padding(.vertical, 6)
                       .foregroundColor(.white)
                       .background(Color(red: 0.96, green: 0.65, blue: 0.80)) // pink pill
                       .cornerRadius(8)
                   }
                   .buttonStyle(.plain)
                   .accessibilityLabel("Colouring Library")

                   // Pro info button
                   Button {
                       showProInfo = true
                   } label: {
                       Text("Colourful Pro")
                           .font(.subheadline.weight(.semibold))
                           .foregroundColor(.white)
                           .padding(.horizontal, 10)
                           .padding(.vertical, 6)
                           .background(
                            Color(red: 0.847, green: 0.588, blue: 1.0)   // Custom Light Purple
                           )
                           .cornerRadius(8)
                   }
                   .accessibilityLabel("Pro features")
                   
                   // Trash / delete mode toggle
                   Button {
                       isDeleteMode.toggle()
                   } label: {
                       Image(systemName: isDeleteMode ? "trash.slash" : "trash")
                           .foregroundColor(toolbarIconColor)
                   }
                   .accessibilityLabel("Delete pages")
               }
           }
       }
       
       // MARK: - Grid content
       
       private var homeGrid: some View {
           LazyVGrid(columns: columns, spacing: 16) {
               newPageTile
               
               ForEach(groupLeaders, id: \.self) { index in
                   // Guard in case store.pages shrinks (e.g. after delete)
                   if index < store.pages.count {
                       bookCard(for: index)
                   }
