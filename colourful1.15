                   if canCreateNewBook {
                       presentPickerAfterDialogDismiss {
                           if !hasSeenFilesImportInfo {
                               showFilesImportInfo = true
                           } else {
                               showingPDFImporter = true
                           }
                       }
                   } else {
                       showProLimitAlert = true
                   }
               }
               
               
               // cancel button
               Button("Cancel", role: .cancel) { }
           }
           
       }
       
       
       // MARK: - Page thumbnail helper

       private func pageThumbnail(for page: ColoringPage) -> some View {
           Canvas { context, size in
               var ctx = context

               let rect = CGRect(origin: .zero, size: size)
               ctx.fill(Path(rect), with: .color(.white))

               // Track how much the image was scaled down for this thumbnail
               var drawScale: CGFloat = 1.0

               // --- background image ---
               var imageDrawRect = rect
               if let uiImage = store.loadBackgroundImage(for: page) {
                   let image = Image(uiImage: uiImage)
                   let resolved = ctx.resolve(image)
                   let imgSize = resolved.size

                   let scale = min(size.width / imgSize.width,
                                   size.height / imgSize.height)
                   drawScale = scale

                   let drawSize = CGSize(width: imgSize.width * scale,
                                         height: imgSize.height * scale)
                   let x = (size.width - drawSize.width) / 2
                   let y = (size.height - drawSize.height) / 2

                   imageDrawRect = CGRect(origin: CGPoint(x: x, y: y), size: drawSize)
                   ctx.draw(resolved, in: imageDrawRect)
               }

               // Helper: stroke a single saved line into ANY GraphicsContext
               func strokeLine(_ line: Line, in g: inout GraphicsContext) {
                   let viewPoints: [CGPoint] = line.points.map { p in
                       switch line.pointSpace {
                       case .imageNormalized, .legacyViewNormalized:
                           return CGPoint(
                               x: imageDrawRect.minX + p.x * imageDrawRect.width,
                               y: imageDrawRect.minY + p.y * imageDrawRect.height
                           )
                       case .viewPoints:
                           return p
                       }
                   }

                   guard viewPoints.count >= 2 else { return }

                   var path = Path()
                   path.move(to: viewPoints[0])
                   for pt in viewPoints.dropFirst() { path.addLine(to: pt) }

                   // --- SAME width logic as Home thumbnails ---
                   let baseWidth = (line.lineWidth ?? 7)
                   let multiplier: CGFloat = line.isMultiply ? 0.95 : 1.10

                   let exponent: CGFloat = (baseWidth >= 18) ? 0.38 : 0.55
                   var effectiveScale = pow(drawScale, exponent)

                   effectiveScale = max(effectiveScale, 0.18)
                   if baseWidth >= 18 { effectiveScale = max(effectiveScale, 0.22) }

                   let thickBoost: CGFloat = (baseWidth >= 24) ? 1.35 : (baseWidth >= 18 ? 1.20 : 1.0)
                   let rawWidth = baseWidth * effectiveScale * multiplier * thickBoost

                   let smallBoost: CGFloat = (baseWidth <= 6) ? 1.15 : 1.0
                   let rawWidth2 = rawWidth * smallBoost

                   let minWidth: CGFloat = max(
                       size.width * 0.0075,
                       (baseWidth <= 6) ? 1.8 : 1.55
                   )
                   let maxWidth: CGFloat = max(6.0, size.width * 0.06)

                   let thumbWidth = min(max(rawWidth2, minWidth), maxWidth)

                   g.stroke(
                       path,
                       with: .color(line.color),
                       style: StrokeStyle(lineWidth: thumbWidth, lineCap: .round, lineJoin: .round)
                   )
               }

               // Multiply strokes: draw into a NORMAL layer first, then multiply ONCE (like your Home thumbnails)
               ctx.blendMode = .multiply
               ctx.drawLayer { layer in
                   layer.blendMode = .normal
                   for line in page.lines where line.isMultiply {
                       strokeLine(line, in: &layer)
                   }
               }

               // Normal strokes on top
               ctx.blendMode = .normal
               for line in page.lines where !line.isMultiply {
                   strokeLine(line, in: &ctx)
               }
           }
           .frame(height: 275)
           .frame(width: 250)
           .background(Color.white)
           .cornerRadius(12)
           .shadow(radius: 2)
       }
       // MARK: - Book card
       
       @ViewBuilder
       private func bookCard(for leaderIndex: Int) -> some View {
           let group = groupIndices(for: leaderIndex)
           let firstIndex = group.first ?? leaderIndex
           
           // Read directly from store.pages so SwiftUI tracks this as a dependency
           let firstPage = store.pages[firstIndex]
           let title = baseName(for: firstPage)
           
           NavigationLink {
               MultiPageDrawingView(
                   store: store,
                   groupIndices: group,
                   initialGroupIndex: 0,
                   title: title
               )
           } label: {
               ZStack(alignment: .topTrailing) {
                   VStack {
                       // Pass the live page directly
                       pageThumbnail(for: store.pages[firstIndex])
                       
                       Text(title)
                           .font(.headline)
                           .foregroundColor(primaryLabelColor)
                           .multilineTextAlignment(.center)
                   }
                   .padding(4)
                   
                   if isDeleteMode {
                       Button {
                           deleteTargetBaseName = title
                           showDeleteAlert = true
                       } label: {
                           Image(systemName: "minus.circle.fill")
                               .font(.title2)
                               .foregroundColor(.red)
                               .padding(6)
                       }
                       .buttonStyle(.plain)
                   }
               }
           }
       }
       
       // MARK: - File & photo handling
       
       private func handleFileImport(_ result: Result<[URL], Error>) {
           switch result {
           case .success(let urls):
               guard let url = urls.first else { return }
               store.importFromFileImporterURL(url)
               
               
           case .failure(let error):
               print("File importer error:", error.localizedDescription)
           }
       }
       
       private func handlePhotoPickerChange(_ newItem: PhotosPickerItem?) {
           // Nothing selected
           guard let item = newItem else { return }
           
           // If we're already in the middle of an import, ignore extra callbacks
           if isImportingPhoto {
               return
           }
           
           isImportingPhoto = true
           
           Task {
               defer {
                   isImportingPhoto = false
               }
               
               if let data = try? await item.loadTransferable(type: Data.self) {
                   let name = "Photo Page"
                   store.addPage(fromImageData: data, named: name)
               } else {
                   print("Failed to load image data from Photos")
               }
               
               // reset so selecting the same image again still triggers
               await MainActor.run {
                   selectedPhotoItem = nil
               }
           }
       }
       
       private func presentPickerAfterDialogDismiss(_ action: @escaping () -> Void) {
           guard !isPresentingSystemPicker else { return }
           isPresentingSystemPicker = true
           
           DispatchQueue.main.asyncAfter(deadline: .now() + 0.30) {
               action()
               DispatchQueue.main.asyncAfter(deadline: .now() + 0.50) {
                   isPresentingSystemPicker = false
               }
           }
       }
       
       
       
       // MARK: - Photos permission handling
       
       private func handleUploadFromPhotosTap() {
           // Respect the free / Pro limit first
           guard canCreateNewBook else {
               showProLimitAlert = true
               return
           }
           
           let status = PHPhotoLibrary.authorizationStatus(for: .readWrite)
           
           switch status {
           case .notDetermined:
               // First time → ask the system for permission directly
               PHPhotoLibrary.requestAuthorization(for: .readWrite) { newStatus in
                   DispatchQueue.main.async {
                       switch newStatus {
                       case .authorized, .limited:
                           self.showingPhotoPicker = true
                       case .denied, .restricted:
                           self.showPhotosSettingsAlert = true
                       @unknown default:
                           self.showingPhotoPicker = true
                       }
                   }
               }
               
           case .authorized, .limited:
               // Already allowed → open picker directly
               showingPhotoPicker = true
               
           case .denied, .restricted:
               // User previously chose "Don't Allow" → show our Settings alert
               showPhotosSettingsAlert = true
               
           @unknown default:
               showingPhotoPicker = true
           }
       }
       
       private func openAppSettings() {
           guard let url = URL(string: UIApplication.openSettingsURLString) else { return }
           if UIApplication.shared.canOpenURL(url) {
               UIApplication.shared.open(url, options: [:], completionHandler: nil)
           }
       }
       
       // MARK: - Grouping helpers
       
       /// Strip " - Page N" off a name to get the base book name
       private func baseName(for page: ColoringPage) -> String {
           if let range = page.name.range(of: " - Page ") {
               return String(page.name[..<range.lowerBound])
           } else {
               return page.name
           }
       }
       
       /// All indices in store.pages that belong to the same book/pdf as this index
       private func groupIndices(for index: Int) -> [Int] {
           let base = baseName(for: store.pages[index])
           // Keep them in order of store.pages
           return store.pages.indices.filter { baseName(for: store.pages[$0]) == base }
       }
       
       /// One "leader" index per group (first page of each book/blank page),
       /// but we walk the pages in reverse so *newest* books appear first in the grid.
       private var groupLeaders: [Int] {
           var seen = Set<String>()
           var leaders: [Int] = []
           
           // walk from last index to first
           for idx in store.pages.indices.reversed() {
               let base = baseName(for: store.pages[idx])
               if !seen.contains(base) {
                   seen.insert(base)
                   leaders.append(idx)
               }
           }
           
           return leaders
       }
       
       // Only count user-created books toward the free limit (ignore starter book)
       private var countedGroupLeaders: [Int] {
           groupLeaders.filter { leaderIndex in
               let base = baseName(for: store.pages[leaderIndex])
               return !limitExemptBookBaseNames.contains(base)
           }
       }
       
       
       /// Delete all pages that share this base/book name
       private func deleteGroup(named base: String) {
           store.pages.removeAll { page in
               baseName(for: page) == base
           }
       }
   }
   
   
   
   
